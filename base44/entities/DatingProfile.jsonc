{
  "name": "DatingProfile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "gender": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "interests": {
      "type": "string"
    },
    "looking_for": {
      "type": "string"
    },
    "photo": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "distance_km": {
      "type": "number",
      "default": 0
    },
    "bpm": {
      "type": "number",
      "default": 72
    },
    "song_url": {
      "type": "string"
    },
    "song_title": {
      "type": "string"
    },
    "song_artist": {
      "type": "string"
    }
  },
  "required": [
    "display_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}