{
  "name": "TodoTask",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "list_name": {
      "type": "string",
      "default": "To Do"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "done": {
      "type": "boolean",
      "default": false
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "remind_at": {
      "type": "string",
      "format": "date-time"
    },
    "reminded": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}