{
  "name": "DatingLike",
  "type": "object",
  "properties": {
    "from_id": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "from_photo": {
      "type": "string"
    },
    "to_id": {
      "type": "string"
    },
    "to_name": {
      "type": "string"
    }
  },
  "required": [
    "from_id",
    "to_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.from_id": "{{user.id}}"
        },
        {
          "data.to_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.from_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}