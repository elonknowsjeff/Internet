{
  "name": "PollVote",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "option_index": {
      "type": "number"
    }
  },
  "required": [
    "post_id",
    "option_index"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}