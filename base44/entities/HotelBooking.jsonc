{
  "name": "HotelBooking",
  "type": "object",
  "properties": {
    "hotel_id": {
      "type": "string"
    },
    "hotel_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "check_in": {
      "type": "string",
      "format": "date"
    },
    "check_out": {
      "type": "string",
      "format": "date"
    },
    "nights": {
      "type": "number"
    },
    "guests": {
      "type": "number",
      "default": 2
    },
    "total": {
      "type": "number"
    },
    "guest_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled"
      ],
      "default": "confirmed"
    },
    "reference": {
      "type": "string"
    }
  },
  "required": [
    "hotel_name",
    "check_in",
    "check_out",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}