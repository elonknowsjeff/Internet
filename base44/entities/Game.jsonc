{
  "name": "Game",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "2D",
        "3D"
      ],
      "default": "2D"
    },
    "perspective": {
      "type": "string",
      "enum": [
        "First Person",
        "Third Person",
        "Top-Down",
        "Side-View",
        "Other"
      ],
      "default": "Other"
    },
    "developer": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 4.0
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "reposts": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "hours_played": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "genre",
    "dimension"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}