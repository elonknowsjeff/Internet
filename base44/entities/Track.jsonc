{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "artist_handle": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "artwork": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "default": 180
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "reposts": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "file_uri": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ],
      "default": "audio"
    },
    "uploaded_by_id": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "uploaded_by_handle": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "upload",
        "spotify"
      ],
      "default": "upload"
    },
    "spotify_id": {
      "type": "string"
    },
    "spotify_type": {
      "type": "string",
      "enum": [
        "track",
        "album",
        "playlist",
        "artist"
      ],
      "default": "track"
    }
  },
  "required": [
    "title",
    "artist_name",
    "source"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}