{
  "name": "SpaceParticipant",
  "type": "object",
  "properties": {
    "space_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_handle": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "host",
        "speaker",
        "listener"
      ],
      "default": "listener",
      "enumColors": [
        "pink",
        "blue",
        "gray"
      ]
    },
    "muted": {
      "type": "boolean",
      "default": true
    },
    "hand_raised": {
      "type": "boolean",
      "default": false
    },
    "is_speaking": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "space_id",
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}