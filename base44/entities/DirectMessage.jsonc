{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string"
    },
    "sender_handle": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_avatar": {
      "type": "string"
    },
    "receiver_id": {
      "type": "string"
    },
    "receiver_handle": {
      "type": "string"
    },
    "receiver_name": {
      "type": "string"
    },
    "receiver_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "voice",
        "call"
      ],
      "default": "text"
    },
    "media_url": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "default": 0
    },
    "call_id": {
      "type": "string"
    },
    "call_kind": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ]
    },
    "call_state": {
      "type": "string",
      "enum": [
        "ringing",
        "accepted",
        "declined",
        "ended"
      ]
    },
    "call_payload": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "sender_id",
    "receiver_id",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.receiver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.receiver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}