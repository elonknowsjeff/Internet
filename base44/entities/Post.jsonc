{
  "name": "Post",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_handle": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "comments": {
      "type": "number",
      "default": 0
    },
    "rebuzzs": {
      "type": "number",
      "default": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "ride",
        "general"
      ],
      "default": "general"
    },
    "repost_of": {
      "type": "string"
    },
    "original_author_name": {
      "type": "string"
    },
    "original_author_handle": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "default": "image"
    },
    "is_creator": {
      "type": "boolean",
      "default": false
    },
    "poll_options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "votes": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "content",
    "author_name",
    "author_handle"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}