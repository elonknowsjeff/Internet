{
  "name": "CloudFile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "size_mb": {
      "type": "number"
    },
    "kind": {
      "type": "string",
      "enum": [
        "document",
        "image",
        "video",
        "audio",
        "archive",
        "other"
      ],
      "default": "other"
    },
    "file_uri": {
      "type": "string"
    },
    "mime": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "size_mb"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}