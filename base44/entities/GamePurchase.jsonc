{
  "name": "GamePurchase",
  "type": "object",
  "properties": {
    "item_type": {
      "type": "string",
      "enum": [
        "game",
        "skin"
      ],
      "default": "game"
    },
    "item_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "order_ref": {
      "type": "string"
    }
  },
  "required": [
    "item_type",
    "item_name",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}